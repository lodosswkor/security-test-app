<div class="card">
  <h2>로그인</h2>
  <br>

  <!-- [취약점] SQL Injection 테스트 가능 -->
  <!-- 예시: email에 ' OR '1'='1' -- 입력 -->
  <%= form_with url: login_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <%= f.label :email, "이메일" %>
      <%= f.email_field :email, placeholder: "이메일 입력" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "비밀번호" %>
      <%= f.password_field :password, placeholder: "비밀번호 입력" %>
    </div>

    <%= f.submit "로그인", class: "btn" %>
  <% end %>

  <br>
  <p>계정이 없으신가요? <a href="/signup">회원가입</a></p>
</div>
